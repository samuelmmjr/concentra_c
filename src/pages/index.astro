---
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Concentra C | Casco Performance</title>
  <meta name="description" content="Conheça a composição do Concentra C, as quantidades por porção e as opções de compra da Casco Performance.">
  <meta name="theme-color" content="#061a10">
  <link rel="preload" as="image" href="/images/hero-floresta.png">
</head>
<body>
<svg class="sr-only" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
<symbol id="leaf" viewBox="0 0 24 24"><path d="M20 4C8 3 3 8 5 15c2 6 13 6 15-11ZM6 19 16 9"/></symbol>
<symbol id="capsule" viewBox="0 0 24 24"><path d="m8 16 8-8M5 19a5 5 0 0 1 0-7l7-7a5 5 0 0 1 7 7l-7 7a5 5 0 0 1-7 0Z"/></symbol>
<symbol id="bolt" viewBox="0 0 24 24"><path d="m13 2-9 12h7l-1 8 10-13h-7l1-7Z"/></symbol>
<symbol id="document" viewBox="0 0 24 24"><path d="M7 3h10l3 3v15H4V3h3ZM8 8h8M8 12h8M8 16h6"/></symbol>
<symbol id="cart" viewBox="0 0 24 24"><path d="M2 3h3l3 12h10l3-8H6M9 21h.01M18 21h.01"/></symbol>
<symbol id="chat" viewBox="0 0 24 24"><path d="M21 11a9 9 0 0 1-13 8l-5 2 2-5A9 9 0 1 1 21 11ZM8 8c1 4 3 6 7 7"/></symbol>
<symbol id="menu-icon" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
</defs></svg>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<div class="site-shell">
  <header>
    <a class="brand" href="#" aria-label="Casco — início"><img src="/images/logo.png" alt="Casco" width="2080" height="1080"></a>
    <nav id="menu" aria-label="Navegação principal"><a href="#formula">Fórmula</a><a href="#uso">Como usar</a><a href="#ofertas">Kits</a><a href="#duvidas">Dúvidas</a></nav>
    <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#menu-icon"></use></svg></button>
    <a class="button nav-button" href="#ofertas" data-event="offer_view_click" data-placement="header">COMPRAR AGORA</a>
  </header>
  <main id="conteudo">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="tag">SUPLEMENTO ALIMENTAR EM CÁPSULAS</p>
        <h1 id="hero-title">Sua rotina exige foco.<br><span>Conheça o Concentra C.</span></h1>
        <p>10 ingredientes em cápsulas, com cafeína, vitaminas e outros nutrientes. Conheça a composição e compre diretamente pelo checkout.</p>
      </div>
      <div class="hero-product"><img src="/images/produto.png" alt="Concentra C, frasco com 60 cápsulas" width="2800" height="2800" fetchpriority="high"></div>
      <div class="hero-attributes">
        <div><span class="icon-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#leaf"></use></svg></span><p><strong>10</strong> ingredientes</p></div>
        <div><span class="icon-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#capsule"></use></svg></span><p><strong>60</strong> cápsulas</p></div>
        <div><span class="icon-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#bolt"></use></svg></span><p>Contém<br> cafeína</p></div>
      </div>
      <div class="hero-actions"><div class="hero-offer"><strong>Escolha entre 1, 3 ou 6 potes</strong><span>A partir de R$ 102,83 por pote no kit de 6</span></div><div class="hero-action-links"><a class="button" href="#ofertas" data-event="offer_view_click" data-placement="hero">QUERO ESCOLHER MEU KIT</a><a class="button outline" href="#formula">CONHECER A FÓRMULA</a></div><p class="checkout-note">7 dias de garantia de devolução do dinheiro. Veja as condições abaixo.</p></div>
    </section>
    <section class="trust-bar" aria-label="Informações para compra">
      <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#document"></use></svg><p><strong>30 porções por frasco</strong><span>60 cápsulas · porção de 2 cápsulas.</span></p></div>
      <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#cart"></use></svg><p><strong>Compra direta na Braip</strong><span>Escolha 1, 3 ou 6 potes.</span></p></div>
      <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#chat"></use></svg><p><strong>Atendimento via WhatsApp</strong><span>Tire suas dúvidas conosco.</span></p></div>
    </section>
    <section id="formula" class="ingredients section-light">
      <div class="section-title"><h2>CONHEÇA OS INGREDIENTES</h2><p>Quantidades por porção de 2 cápsulas.</p></div>
      <div class="ingredient-grid">
<article class="ingredient"><div class="ingredient-photo" style="--x:0%;--y:0%" aria-hidden="true"></div><div><h3>Cafeína</h3><p>75 mg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:25%;--y:0%" aria-hidden="true"></div><div><h3>L-Tirosina</h3><p>200 mg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:50%;--y:0%" aria-hidden="true"></div><div><h3>Colina</h3><p>100 mg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:75%;--y:0%" aria-hidden="true"></div><div><h3>Coenzima Q10</h3><p>30 mg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:100%;--y:0%" aria-hidden="true"></div><div><h3>Magnésio</h3><p>150 mg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:0%;--y:50%" aria-hidden="true"></div><div><h3>L-Triptofano</h3><p>100 mg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:25%;--y:50%" aria-hidden="true"></div><div><h3>Vitamina B3</h3><p>30 mg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:50%;--y:50%" aria-hidden="true"></div><div><h3>Vitamina B12</h3><p>4,8 µg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:75%;--y:50%" aria-hidden="true"></div><div><h3>Vitamina D3</h3><p>50 µg</p></div></article>
<article class="ingredient"><div class="ingredient-photo" style="--x:100%;--y:50%" aria-hidden="true"></div><div><h3>Fosfatidilserina</h3><p>30 mg</p></div></article>
      </div>
      <p class="label-note">Composição informada pela marca. Imagens ilustrativas dos ingredientes. Confira o rótulo atualizado.</p>
      <section class="usage" id="uso" aria-labelledby="usage-title"><div class="usage-heading"><span class="tag">SIMPLES DE INCLUIR NA ROTINA</span><h2 id="usage-title">MODO DE USO</h2></div><div class="usage-items"><article class="usage-step"><span class="step-number">01</span><h3>Quantidade diária</h3><p>2 cápsulas ao dia*</p></article><article class="usage-step"><span class="step-number">02</span><h3>Quando tomar</h3><p>Preferencialmente pela manhã*</p></article><article class="usage-step"><span class="step-number">03</span><h3>Atenção à cafeína</h3><p>75 mg por porção. Considere outras fontes e sua sensibilidade.</p></article></div><p class="usage-note">*Orientação informada pela marca. Siga o rótulo atualizado e a orientação de um profissional de saúde.</p></section>
      <div class="audiences">
        <div class="section-title"><h2>UMA ROTINA INTENSA PEDE ESCOLHAS CONSCIENTES</h2><p>Trabalho, estudos ou atividades do dia a dia: conheça o produto antes de incluí-lo na sua rotina.</p></div>
        <div class="audience-grid">
<article><div class="audience-photo" style="--x:0%;--y:100%" role="img" aria-label="Imagem ilustrativa: Profissionais"></div><h3>Profissionais</h3></article>
<article><div class="audience-photo" style="--x:25%;--y:100%" role="img" aria-label="Imagem ilustrativa: Estudantes"></div><h3>Estudantes</h3></article>
<article><div class="audience-photo" style="--x:50%;--y:100%" role="img" aria-label="Imagem ilustrativa: Criativos"></div><h3>Criativos</h3></article>
<article><div class="audience-photo" style="--x:75%;--y:100%" role="img" aria-label="Imagem ilustrativa: Atletas e praticantes"></div><h3>Atletas e praticantes</h3></article>
        </div>
      </div>
    </section>
    <section id="ofertas" class="offers">
      <div class="section-title"><h2>ESCOLHA SEU KIT</h2><p>1, 3 ou 6 potes. Compra direta na Braip.</p></div>
      <div class="compact-kits">
        <article class="compact-kit">
          <img src="/images/kit-1.png" alt="Kit com 1 pote de Concentra C" loading="lazy" />
          <div class="compact-kit-copy"><h3>1 pote</h3><span class="compact-portions">60 cápsulas · 30 porções</span><strong>R$ 147,00</strong><p>R$ 147,00 por pote</p><span class="compact-saving">Escolha para começar</span><a class="button" href="https://buy.braip.com/checkout/plajekdg/che6vvg1" data-event="checkout_click" data-kit="1" data-placement="kit">QUERO 1 POTE</a></div>
        </article>
        <article class="compact-kit compact-kit-featured">
          <img src="/images/kit-3.png" alt="Kit com 3 potes de Concentra C" loading="lazy" />
          <div class="compact-kit-copy"><h3>3 potes</h3><span class="compact-portions">180 cápsulas · 90 porções</span><strong>R$ 357,00</strong><p>R$ 119,00 por pote</p><span class="compact-saving">Economize R$ 84,00*</span><a class="button" href="https://buy.braip.com/checkout/pla0xor8/che6vvg1" data-event="checkout_click" data-kit="3" data-placement="kit">QUERO 3 POTES</a></div>
        </article>
        <article class="compact-kit">
          <img src="/images/kit-6.png" alt="Kit com 6 potes de Concentra C" loading="lazy" />
          <div class="compact-kit-copy"><h3>6 potes</h3><span class="compact-portions">360 cápsulas · 180 porções</span><strong>R$ 617,00</strong><p>R$ 102,83 por pote</p><span class="compact-saving">Economize R$ 265,00*</span><a class="button" href="https://buy.braip.com/checkout/play4k6o/che6vvg1" data-event="checkout_click" data-kit="6" data-placement="kit">QUERO 6 POTES</a></div>
        </article>
      </div>
      <p class="offer-note">*Comparação com a mesma quantidade de potes avulsos a R$ 147,00. Valores antes do frete; confira descontos, pagamento e total na Braip.</p>
    </section>

    <section class="money-guarantee" id="garantia" aria-labelledby="guarantee-title"><div class="guarantee-seal" aria-hidden="true">7<span>DIAS</span></div><div><p class="tag">SUA COMPRA COM MAIS TRANQUILIDADE</p><h2 id="guarantee-title">Garantia de devolução do dinheiro</h2><p>Você tem 7 dias após o recebimento para solicitar a devolução. Fale com nosso suporte para receber as instruções e conhecer o procedimento de reembolso.</p><a href="https://wa.me/5569992734388" target="_blank" rel="noopener noreferrer">Consultar condições de devolução</a></div></section><section id="duvidas" class="faq section-light">
      <div class="section-title"><h2>DÚVIDAS FREQUENTES</h2></div>
      <div class="faq-list">
        <details><summary>O que é o Concentra C?<span aria-hidden="true">⌄</span></summary><p>É um suplemento alimentar em cápsulas. Consulte a composição, o rótulo e suas advertências para avaliar se é adequado à sua rotina.</p></details>
        <details><summary>Como devo usar o produto?<span aria-hidden="true">⌄</span></summary><p>O material da marca informa 2 cápsulas ao dia, preferencialmente pela manhã. Confira o rótulo atualizado e siga a orientação de um profissional de saúde.</p></details>
        <details><summary>Quais são os ingredientes?<span aria-hidden="true">⌄</span></summary><p>A composição informada está apresentada nesta página por porção de 2 cápsulas. Solicite o rótulo atualizado para consultar também excipientes, alergênicos e advertências.</p></details>
        <details><summary>O produto contém cafeína?<span aria-hidden="true">⌄</span></summary><p>Sim. A composição informada indica 75 mg por porção de 2 cápsulas. Considere outras fontes de cafeína e sua sensibilidade individual.</p></details>
        <details><summary>Como funcionam a entrega e o pagamento?<span aria-hidden="true">⌄</span></summary><p>Escolha o kit de 1, 3 ou 6 potes e clique em comprar. Confira o frete, o total e as opções de pagamento na Braip antes de finalizar.</p></details>
      </div><div class="final-purchase"><h3>Escolha seu kit e compre agora</h3><p>1, 3 ou 6 potes. Compare as opções e encontre a quantidade para sua rotina.</p><a class="button" href="#ofertas" data-event="offer_view_click" data-placement="faq">VER PREÇOS E ESCOLHER MEU KIT</a></div>
      <a class="support-link" href="https://wa.me/5569992734388" target="_blank" rel="noopener noreferrer" data-event="support_contact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#chat"></use></svg> Falar com o suporte</a>
    </section>
  </main>
  <footer>
    <div class="footer-main">
      <a class="brand" href="#" aria-label="Casco — início"><img src="/images/logo.png" alt="Casco" width="2080" height="1080" loading="lazy"></a>
      <nav aria-label="Navegação no rodapé"><a href="#formula">Fórmula</a><a href="#uso">Como usar</a><a href="#ofertas">Kits</a><a href="#duvidas">Dúvidas</a></nav>
      <a class="footer-chat" href="https://wa.me/5569992734388" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp da Casco"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#chat"></use></svg></a>
    </div>
    <div class="footer-legal"><p>© 2026 Casco Performance · <a href="mailto:suporte@cascoperformance.com.br">suporte@cascoperformance.com.br</a></p><p>Suplemento alimentar. Este produto não é um medicamento. Consulte o rótulo e suas advertências.</p></div>
  </footer>
</div>
<a class="mobile-purchase" href="#ofertas" data-event="offer_view_click" data-placement="mobile"><span><strong>Concentra C</strong><small>Escolha 1, 3 ou 6 potes</small></span><b>ESCOLHER KIT</b></a>
<script is:inline>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#menu');
  const closeMenu = () => { toggle.setAttribute('aria-expanded', 'false'); menu.classList.remove('open'); };
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('open', open);
  });
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
  document.querySelectorAll('[data-event]').forEach(a => a.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('casco:analytics', { detail: { event: a.dataset.event, kit: a.dataset.kit || null, placement: a.dataset.placement || null } }));
  }));
</script>
</body>
</html>
