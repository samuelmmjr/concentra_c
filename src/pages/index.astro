---
import '../styles/global.css';
import { company, siteUrl, reviews } from '../config/site';
import Tracking from '../components/Tracking.astro';
const canonical = siteUrl ? `${siteUrl}/` : null;
const reviewTotal = Object.values(reviews).reduce((a, b) => a + b, 0);
const reviewAverage = (reviews.five * 5 + reviews.four * 4 + reviews.three * 3 + reviews.two * 2 + reviews.one) / reviewTotal;
const ratingRows = [5,4,3,2,1].map((stars, i) => ({ stars, count: [reviews.five,reviews.four,reviews.three,reviews.two,reviews.one][i] }));
const productSchema = {
  '@context': 'https://schema.org', '@type': 'Product',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: reviewAverage.toFixed(2), reviewCount: reviewTotal, bestRating: 5, worstRating: 1 },
  name: 'Concentra C', description: 'Suplemento alimentar em cápsulas. Kits de 1, 3 e 6 potes, com 60 cápsulas por pote.',
  brand: { '@type': 'Brand', name: company.brand },
  ...(siteUrl ? { image: [`${siteUrl}/images/produto.png`], url: canonical } : {}),
  offers: [
    {n:1, price:'147.00', slug:'plajekdg'},
    {n:3, price:'357.00', slug:'pla0xor8'},
    {n:6, price:'617.00', slug:'play4k6o'}
  ].map(k => ({'@type':'Offer', name:`Kit de ${k.n} potes`, price:k.price, priceCurrency:'BRL', url:`https://buy.braip.com/checkout/${k.slug}/che6vvg1`}))
};
